# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/
build/
dist/

# Downloaded media — never commit
downloads/
tests/_smoke/
*.mp4
*.webm
*.mkv
*.mov
*.m4v
*.ts
*.flv
*.part
*.part-*

# Secrets / local config
cookies.txt
cookies_*.txt
*.cookies.txt
config.json
config.json.*
!config.example.json
# Proxy config (contains credentials — never commit)
site_proxies.json
proxies.txt
# Per-site API credentials (X bearer/auth_token/ct0, etc). Kept out of
# config.json on purpose so UI reads/screenshots/bug reports can't leak them.
secrets.json
secrets.json.*
# VPN auto-rotation config (machine-local; the .example template stays committed)
vpn_config.json
# Streamonitor's vendored config (live model list — usernames/room_ids)
live_backend/config.json
live_backend/config.json.*
# Config-database backups. Whole dir: copies get renamed on the way in
# (live_backend/config.json -> live_backend-config.json), so filename-based
# rules above don't catch them and the model list would leak.
backups/

# State files — generated at runtime
universal.log
history.json
failed.json
debug_*.html
debug_*.txt

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*.bak
*.orig
.DS_Store
Thumbs.db

# OS / tool junk
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# Runtime log dirs (rotated logs like live-errors.log.2026-06-25 aren't caught by *.log)
logs/
live_backend/logs/

# Embedded Tor runtime cache (tor_helper.py writes consensus/microdesc here)
_tor_data/

# Live recording rolling-playlist scratch files (StreaMonitor M3U8 buffer)
live_backend/M3U8_TMP/
M3U8_TMP/

# Per-site cookie jars (sensitive — exported from browser per user)
cookies/

# Live recording manager state (regenerated at runtime; site-specific)
live_models.json
_progress.json

# Local research / notes / assistant scratch — not shipped with the project
research/
**/.claude/
CLAUDE.md
claude_*.md
*.scratch.md
*.notes.md
.memory/
.claude/
